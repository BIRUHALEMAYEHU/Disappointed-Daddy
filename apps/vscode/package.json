{
  "name": "disappointed-dad-vscode",
  "displayName": "Disappointed Dad",
  "description": "I'm not angry. I'm just disappointed you can't explain your own backend. An AI interviewer that makes you defend your code.",
  "license": "MIT",
  "version": "0.1.0",
  "publisher": "dissappointeddaddy",
  "homepage": "https://disappointed-daddy.vercel.app",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "AI",
    "Other"
  ],
  "keywords": [
    "interview",
    "learning",
    "code review",
    "ai",
    "claude"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "disappointedDad.start",
        "title": "Start Interview",
        "category": "Disappointed Dad",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "disappointedDad.reportCard",
        "title": "Show Report Card",
        "category": "Disappointed Dad"
      },
      {
        "command": "disappointedDad.setApiKey",
        "title": "Set API Key",
        "category": "Disappointed Dad"
      },
      {
        "command": "disappointedDad.clearApiKey",
        "title": "Remove API Keys",
        "category": "Disappointed Dad"
      }
    ],
    "configuration": {
      "title": "Disappointed Dad",
      "properties": {
        "disappointedDad.provider": {
          "type": "string",
          "enum": [
            "auto",
            "anthropic",
            "hosted",
            "ollama"
          ],
          "enumDescriptions": [
            "Your API key if set, otherwise Dad Pro if you've run `dad login`",
            "Claude with your own API key",
            "Dad Pro subscribers (run `dad login` in a terminal first)",
            "A local Ollama model: nothing leaves your machine"
          ],
          "default": "auto",
          "description": "Where Dad's brain lives."
        },
        "disappointedDad.byokProvider": {
          "type": "string",
          "enum": ["anthropic", "openai", "gemini", "openrouter", "deepseek", "groq"],
          "description": "Which provider your own API key is for (set with \"Disappointed Dad: Set API Key\")."
        },
        "disappointedDad.byokModel": {
          "type": "string",
          "default": "",
          "description": "Model for a non-Anthropic provider, e.g. gemini-3.8-flash."
        },
        "disappointedDad.model": {
          "type": "string",
          "default": "",
          "description": "Model override. Empty = claude-opus-5-5 (or gpt-oss:20b for Ollama)."
        },
        "disappointedDad.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama address."
        },
        "disappointedDad.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Dad Pro server. Empty = the one `dad login` used."
        },
        "disappointedDad.daddyMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "🤫 Adults-only innuendo voice. Same questions, cheekier delivery. Not for the office. Ignored in projects with `\"daddyMode\": false` in `.disappointed-dad.json`."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && node build.mjs --production && npx --yes @vscode/vsce@3 package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@disappointed-dad/core": "0.1.0",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.25.0"
  }
}
