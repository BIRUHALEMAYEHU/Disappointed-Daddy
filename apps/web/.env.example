# Copy to .env.local and fill in. Never commit the real file.

# Public URL of this app (no trailing slash). Locally: http://localhost:3000
APP_URL=http://localhost:3000

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string, "Transaction pooler")
DATABASE_URL=postgres://user:password@host:6543/postgres

# GitHub OAuth app (github.com/settings/developers -> New OAuth App)
# Callback URL must be: <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Your Anthropic API key: pays for Dad Pro users only (everyone else brings their own key). Optional until you sell Pro.
ANTHROPIC_API_KEY=

# Free Pro for people you choose: GitHub NUMERIC IDs (not usernames), comma separated.
# Find an ID at https://api.github.com/users/<username> -> "id". Usernames can be renamed and reclaimed; IDs can't.
PRO_GITHUB_IDS=

# Ethiopian payments (verify.et): API key with verification:write + verification:read
VERIFY_ET_API_KEY=
# Prepaid credit: Birr per 1 USD of AI usage (your margin is built in), and the smallest accepted payment
BIRR_PER_USD=250
BIRR_MIN_TOPUP=250
# Where customers pay (shown on /pro). JSON; supported: telebirr, cbe, dashen, awash, mpesa
BIRR_ACCOUNTS={"telebirr":{"account":"09XXXXXXXX","name":"Your Name"},"cbe":{"account":"1000XXXXXXXXX","name":"Your Name"}}

# Optional
HOSTED_MODEL=claude-opus-5-5
PRO_DAILY_REQUESTS=150
BYOK_DAILY_REQUESTS=1000
